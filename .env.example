# Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Foto bukti stok masuk diupload lewat Supabase Storage dengan sesi user
# (lihat migration storage_bukti_stok_masuk), jadi tidak perlu S3 key.

# Jangan taruh service role key di sini: semua variabel VITE_* ikut ter-bundle
# ke browser. Operasi admin memakai Edge Function `admin-users`.
