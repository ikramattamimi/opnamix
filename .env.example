# Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Supabase Storage via S3 protocol (Project Settings > Storage > S3 Connection)
# Dipakai untuk upload foto bukti stok masuk ke bucket `bukti-stok-masuk`.
VITE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
VITE_S3_REGION=
VITE_S3_ACCESS_KEY_ID=
VITE_S3_SECRET_ACCESS_KEY=

# Jangan taruh service role key di sini: semua variabel VITE_* ikut ter-bundle
# ke browser. Operasi admin memakai Edge Function `admin-users`.
